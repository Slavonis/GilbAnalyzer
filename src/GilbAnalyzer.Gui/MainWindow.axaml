<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="GilbAnalyzer.Gui.MainWindow"
        Width="1180" Height="780"
        MinWidth="920" MinHeight="620"
        Title="Метрики Джилба — анализатор потока управления кода JavaScript">

  <Grid RowDefinitions="Auto,*" Margin="12">

    <!-- Панель инструментов -->
    <Border Grid.Row="0" Background="#F2F4F8" CornerRadius="8" Padding="10" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="OpenButton" Content="Открыть .js файл…" Padding="12,6" />
        <Button x:Name="AnalyzeButton" Content="Анализировать" Padding="12,6"
                Background="#2D6CDF" Foreground="White" FontWeight="SemiBold" />
        <Button x:Name="SampleButton" Content="Загрузить пример" Padding="12,6" />
        <Button x:Name="ClearButton" Content="Очистить" Padding="12,6" />
        <TextBlock x:Name="FileLabel" Text="Файл не выбран" VerticalAlignment="Center"
                   Margin="10,0,0,0" Foreground="#5B6472" />
      </StackPanel>
    </Border>

    <!-- Основная область -->
    <Grid Grid.Row="1" ColumnDefinitions="2*,Auto,3*">

      <!-- Исходный код -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Исходный код JavaScript"
                   FontWeight="SemiBold" Margin="2,0,0,6" />
        <Border Grid.Row="1" BorderBrush="#D3D8E0" BorderThickness="1" CornerRadius="6">
          <TextBox x:Name="SourceBox"
                   AcceptsReturn="True" AcceptsTab="True"
                   TextWrapping="NoWrap"
                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                   FontSize="13"
                   VerticalAlignment="Stretch"
                   Watermark="Вставьте сюда код JavaScript или откройте файл…"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" Background="Transparent"
                    ResizeDirection="Columns" />

      <!-- Результаты -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock Grid.Row="0" Text="Результат — метрики Джилба"
                   FontWeight="SemiBold" Margin="2,0,0,8" />

        <!-- Три главные метрики -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
          <Border Grid.Column="0" Background="#EAF0FB" CornerRadius="8" Padding="14,12" Margin="0,0,5,0">
            <StackPanel>
              <TextBlock Text="Абсолютная сложность" Foreground="#5B6472" FontSize="12" />
              <TextBlock Text="CL" Foreground="#2D6CDF" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="CLValue" Text="0" FontSize="30" FontWeight="Bold" />
              <TextBlock Text="число условных операторов" Foreground="#5B6472" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#EAF0FB" CornerRadius="8" Padding="14,12" Margin="5,0,5,0">
            <StackPanel>
              <TextBlock Text="Относительная сложность" Foreground="#5B6472" FontSize="12" />
              <TextBlock Text="cl = CL / N" Foreground="#2D6CDF" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="ClValue" Text="0,000" FontSize="30" FontWeight="Bold" />
              <TextBlock x:Name="ClFormula" Text="—" Foreground="#5B6472" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#EAF0FB" CornerRadius="8" Padding="14,12" Margin="5,0,0,0">
            <StackPanel>
              <TextBlock Text="Макс. уровень вложенности" Foreground="#5B6472" FontSize="12" />
              <TextBlock Text="CLI" Foreground="#2D6CDF" FontSize="12" FontWeight="SemiBold" />
              <TextBlock x:Name="CLIValue" Text="0" FontSize="30" FontWeight="Bold" />
              <TextBlock Text="условных операторов" Foreground="#5B6472" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="Детализация управляющих конструкций"
                   FontWeight="SemiBold" Margin="2,0,0,6" />

        <!-- Таблица детализации -->
        <DataGrid Grid.Row="3" x:Name="BreakdownGrid"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  BorderBrush="#D3D8E0" BorderThickness="1"
                  CanUserResizeColumns="True"
                  AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Конструкция" Binding="{Binding Construct}" Width="2*" />
            <DataGridTextColumn Header="Кол-во" Binding="{Binding Count}" Width="80" />
            <DataGridTextColumn Header="Вклад в CL" Binding="{Binding ContributionToCL}" Width="100" />
            <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="2*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </Grid>
</Window>
